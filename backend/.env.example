# ============================================
# SIPPCI - Backend Environment Variables
# Copiar a .env y completar valores reales
# ============================================
DATABASE_URL="postgresql://postgres:password@localhost:5433/sippci_v2?schema=public"
JWT_SECRET="cambiar_por_secreto_seguro_32_chars"
JWT_EXPIRES_IN="7d"
PORT=3000
NODE_ENV="development"
CORS_ORIGIN="http://localhost:5173"
FRONTEND_URL="http://localhost:5173"
# Email SMTP (cuando se active nodemailer real)
# SMTP_HOST=""
# SMTP_PORT=587
# SMTP_USER=""
# SMTP_PASS=""
